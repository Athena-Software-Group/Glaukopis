# Copy to .env (gitignored) and fill in. Read by tmpl_gen (src/tmpl_gen/neo4j_env.py),
# the _v21_*_build scripts, and the athena_cti_db / tmpl_gen shell utilities
# (source it with: set -a; . ./.env; set +a).
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DB=athena-cti-db
